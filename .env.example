# ============================================================
# HikeShield — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# Variables marked with * are REQUIRED for production.
# ============================================================

# --------------------------
# Shared / networking
# --------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080
AI_SERVICE_PORT=8090

# --------------------------
# Backend — Core
# --------------------------
# * Comma-separated list of allowed frontend origins (no wildcard allowed)
CORS_ORIGIN=http://localhost:5173

# * Minimum 32 characters — used for JWT signing
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional — token expiry (default: 7d)
AUTH_JWT_EXPIRES_IN=7d

# Optional — fallback to in-memory if unset
DATABASE_URL=
# Set to "false" only if your Postgres host does not support TLS
DATABASE_SSL=true

# Optional — fallback to in-memory if unset
REDIS_URL=
REDIS_TTL_SECONDS=90

# --------------------------
# Backend — External APIs
# --------------------------
# * Required for route planning
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_API_BASE_URL=https://api.openrouteservice.org
OPENROUTESERVICE_PROFILE=foot-hiking
OPENROUTESERVICE_SNAP_RADIUS_M=1000

# Optional — adds weather hazard layer
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# Optional — VicEmergency feed (RSS/GeoJSON)
VIC_EMERGENCY_FEED_URL=
VIC_EMERGENCY_API_KEY=

# Optional — VicRoads incidents
VICROADS_API_URL=
VICROADS_API_KEY=

# Optional — Bureau of Meteorology
BOM_FEED_URL=

# Optional — elevation & overpass (defaults use free public endpoints)
OPENTOPO_DATA_API_URL=https://api.opentopodata.org/
OPENTOPO_DATA_DATASET=aster30m
OPEN_METEO_ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Optional — hiking speed estimate (km/h, default 4.5)
HIKING_BASE_SPEED_KMH=4.5

# --------------------------
# Backend — AI Service
# --------------------------
# * Canonical backend origin used for redirects and absolute public URLs
PUBLIC_API_ORIGIN=http://localhost:8080
AI_SERVICE_URL=http://localhost:8090
# * Shared backend <-> AI service token, minimum 16 characters outside tests
AI_SERVICE_AUTH_TOKEN=replace-with-a-random-token-at-least-16-characters
AI_SERVICE_REQUEST_TIMEOUT_MS=5000
# Optional — explicit table name for knowledge articles
KNOWLEDGE_ARTICLE_TABLE=

# --------------------------
# Backend — Scheduler
# --------------------------
# Hazard poll interval in milliseconds (default 7,200,000 = 2 hours)
FETCH_INTERVAL_MS=7200000
# How long before data is considered stale (ms, default 600,000 = 10 min)
STALE_THRESHOLD_MS=600000
# Which hazard layers to pull (comma-separated)
DEFAULT_LAYERS=fire,flood,storm,heat

# --------------------------
# AI-Service (Node / Express)
# --------------------------
# * Required for route narration
GEMINI_API_KEY=
GEMINI_ROUTE_NARRATION_MODEL=gemini-2.5-flash-lite
GEMINI_ROUTE_NARRATION_TIMEOUT_MS=4500
WORKER_CONCURRENCY=2

# --------------------------
# Frontend (Vite)
# --------------------------
# Set in Vercel dashboard:
#   VITE_HAZARD_API_BASE_URL = https://your-backend.railway.app/api
VITE_HAZARD_API_BASE_URL=http://localhost:8080/api
# Backward-compatible alias supported by the frontend code.
VITE_API_BASE_URL=http://localhost:8080/api
# Preview gate password. This is client-visible and not a substitute for backend auth.
VITE_SITE_ACCESS_PASSWORD=replace-with-preview-password
