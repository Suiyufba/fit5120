{
  "base_model": "Qwen/Qwen2.5-0.5B-Instruct",
  "train_file": "training/route-intro/data/combined-smoke/route_intro_train.sampled.jsonl",
  "eval_file": "training/route-intro/data/combined-smoke/route_intro_eval.sampled.jsonl",
  "output_dir": "training/route-intro/artifacts/qwen2.5-0.5b-route-intro-smoke-lora",
  "max_seq_length": 1024,
  "learning_rate": 0.00015,
  "num_train_epochs": 1,
  "max_steps": 20,
  "per_device_train_batch_size": 1,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "device_map": "cpu",
  "use_cpu": true,
  "warmup_ratio": 0.05,
  "weight_decay": 0.01,
  "logging_steps": 5,
  "save_steps": 20,
  "eval_steps": 20,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "seed": 42
}
